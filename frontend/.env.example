# Copy this file to `.env.local` and fill in the values.

# Backend API base URL.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Public base URL that webhook senders post to.
NEXT_PUBLIC_INGEST_URL=http://localhost:3001/hooks

# Clerk credentials. Use the SAME Clerk application as the backend,
# otherwise tokens are rejected with a jwk-kid-mismatch error.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
