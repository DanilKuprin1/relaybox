# Copy this file to `.env` and fill in the values.

# PostgreSQL connection string (requires PostgreSQL >= 15).
# This default matches the database created by ../docker-compose.yaml.
DATABASE_URL="postgresql://relaybox:relaybox@localhost:5432/relaybox"

# Clerk credentials. Use the SAME Clerk application as the frontend,
# otherwise tokens are rejected with a jwk-kid-mismatch error.
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Optional. Defaults shown.
PORT=3001
FRONTEND_ORIGIN=http://localhost:3000
LOG_LEVEL=debug

# Optional. Leave unset to disable Sentry reporting.
SENTRY_DSN=
